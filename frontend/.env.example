# Backend base URL (no trailing slash). Screenshots and SSE streams are served from here too.
# Blank = port 8000 on whatever host the page was opened from (http://localhost:8000 locally,
# http://192.168.1.20:8000 when a teammate opens http://192.168.1.20:3000 on the same Wi-Fi).
# The backend allows LAN origins in development; for a deployed frontend add its origin to the
# backend's FRONTEND_ORIGINS.
NEXT_PUBLIC_API_URL=

# Optional Supabase auth. Set BOTH to require login (email + password or magic link at /login);
# the session token is sent as `Authorization: Bearer` on every API call and as `access_token`
# on run streams. Leave blank for demo mode (no login; the backend's dev account is used).
# The backend must agree: SUPABASE_JWT_SECRET (or SUPABASE_JWKS_URL) set there when these are set,
# blank when these are blank. A mismatch shows a "Sign-in is misconfigured" banner in the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional support address shown in the Help centre (falls back to a demo placeholder).
NEXT_PUBLIC_SUPPORT_EMAIL=
