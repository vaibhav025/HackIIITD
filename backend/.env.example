# ShelfSense backend configuration. Copy to `.env` only if you need to change
# something; with every value blank the app runs fully on local mocks.

# development | production. Production requires SUPABASE_JWT_SECRET, disables
# demo auth and test-mode plan switching, and stops serving /media publicly.
APP_ENV=development

# Blank = each integration is real when its key is set. `true` forces every
# integration (TinyFish, Gemini, storage) into mock mode even with keys present.
MOCK_MODE=

# Blank = SQLite at ./shelfsense.db. Supabase: Project Settings -> Database ->
# Connection string -> Session pooler, then change the prefix to postgresql+asyncpg://
#   postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (The transaction pooler on port 6543 also works.) Alembic uses this same URL.
DATABASE_URL=

# TinyFish (official `tinyfish` SDK). With a key (and MOCK_MODE not true)
# checks run live; otherwise the simulated agent is used. Server-side only:
# never put this key in the frontend. Get one at agent.tinyfish.ai/api-keys.
TINYFISH_API_KEY=
# Agent/browser sessions running at once across the whole process.
TINYFISH_MAX_CONCURRENCY=2
# Per agent-run timeout in seconds. Live stealth checks take 3-8 minutes (TinyFish max is 600).
TINYFISH_AGENT_TIMEOUT_SECONDS=600
# Whole budget in seconds for one Browser API pincode check.
TINYFISH_BROWSER_TIMEOUT_SECONDS=120
# Proxy exit country for browser sessions (ISO code). IN so Indian apps
# see an Indian visitor; TinyFish itself defaults to US.
TINYFISH_PROXY_COUNTRY=IN
# Refuse live runs needing more checks than this (0 = no limit). Each live
# check is a paid agent run of a few minutes.
TINYFISH_LIVE_MAX_JOBS_PER_RUN=6
# Optional Browser Context Profile per app (prof_...): a saved, signed-in
# TEAM test account session, which sites block far less. Blank = anonymous.
TINYFISH_PROFILE_BLINKIT=
TINYFISH_PROFILE_ZEPTO=
TINYFISH_PROFILE_INSTAMART=
# Apps checked live (Blinkit blocks automated browsers, so it is off).
TINYFISH_LIVE_PLATFORMS=zepto,instamart,amazon,flipkart
# true = replay real results saved in data/demo_results.json instead of calling
# TinyFish (safe stage demo). Failed live checks fall back to that cache anyway.
TINYFISH_DEMO=false

# Google Gemini for summaries, recommendations, chat and rule parsing.
# Blank = rule-based fallback with the same response shapes.
GEMINI_API_KEY=
GEMINI_MODEL=

# Telegram bot. Blank token = bot not started, messages are logged instead.
# The username (without @) enables t.me deep links on link codes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Supabase. URL + service key switch screenshot storage to Supabase Storage.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Verifies user access tokens. HS256 tokens (legacy JWT secret) are checked with
# SUPABASE_JWT_SECRET; ES256/RS256 tokens (new signing keys) against the project's
# JWKS at {SUPABASE_URL}/auth/v1/.well-known/jwks.json (SUPABASE_URL must be set).
# With both blank in development = demo auth: every request is the seeded demo
# user. Production needs one of them.
SUPABASE_JWT_SECRET=
# Optional JWKS override. Setting it also enables Supabase auth without a secret
# (projects that only use asymmetric signing keys).
SUPABASE_JWKS_URL=
SUPABASE_STORAGE_BUCKET=screenshots

# Frontend origin for CORS and links in Telegram messages. Development also
# allows any port on localhost, 127.0.0.1 and private LAN addresses
# (10.x, 172.16-31.x, 192.168.x), so a demo opened from another laptop on the
# same Wi-Fi works without changes.
FRONTEND_ORIGIN=http://localhost:3000
# Extra comma-separated origins for CORS, e.g. a deployed frontend:
#   FRONTEND_ORIGINS=https://shelfsense.vercel.app,http://192.168.1.20:3000
FRONTEND_ORIGINS=
